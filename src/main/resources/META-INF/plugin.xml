<idea-plugin url="https://github.com/smijsm/Perforator">
    <id>com.perforator.perforator</id>
    <name>Perforator - Continuous profiling integration</name>
    <version>1.1.0</version>
    <vendor email="smijsm@gmail.com">Michael Solovev</vendor>
    <description><![CDATA[
    Bring continuous profiling data into your IDE. Fetch data from Grafana Pyroscope or load Google Cloud Profiler files (.pb.gz), visualize performance hotspots with inline gutter badges, and generate AI optimization prompts.

    <h3>Features:</h3>
    <ul>
    <li><strong>Multiple Data Sources:</strong> Grafana Pyroscope API + Google Cloud Profiler files</li>
    <li><strong>Inline Performance Badges:</strong> CPU time or memory allocation next to code</li>
    <li><strong>File Upload Support:</strong> Load .pb.gz files from Google Cloud Profiler</li>
    <li><strong>AI Integration:</strong> Right-click badges to copy performance optimization prompts</li>
    <li><strong>Configurable Thresholds:</strong> Customize hot spot detection</li>
    </ul>

    <h3>Supported:</h3>
    <ul>
    <li><strong>Languages:</strong> Java, Kotlin</li>
    <li><strong>Profile Types:</strong> CPU time, Wall time (Google Profiler only), Memory</li>
    <li><strong>IDEs:</strong> IntelliJ IDEA 2025.1.2+, Android Studio 2025.1.2+</li>
    </ul>
    <br/>
    <b>Contribute:</b> <a href="https://github.com/smijsm/Perforator">Project on GitHub</a>
]]>
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.lang</depends>

    <idea-version since-build="251"/>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                parentId="tools"
                instance="com.perforator.perforator.PerforatorConfigurable"
                id="com.perforator.perforator.PerforatorConfigurable"
                displayName="Perforator"/>
        <annotator
                language="JAVA"
                implementationClass="com.perforator.perforator.PerforatorGutterAnnotator"/>
        <annotator
                language="kotlin"
                implementationClass="com.perforator.perforator.PerforatorGutterAnnotator"/>
        <notificationGroup id="Perforator Notifications"
                           displayType="BALLOON"
                           key="notification.group.perforator"/>
        <notificationGroup id="Perforator"
                           displayType="BALLOON"/>
        <projectService serviceImplementation="com.perforator.perforator.PerforatorSettingsService"/>
        <projectService serviceImplementation="com.perforator.perforator.PerforatorService"/>
    </extensions>

    <actions>
        <action id="com.perforator.perforator.FetchFromPyroscopeAction"
                class="com.perforator.perforator.FetchFromPyroscopeAction"
                text="Fetch Profiling Data"
                description="Fetch profiling data from Grafana Pyroscope and show performance toolbar">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="LoadProfileFileAction"
                class="com.perforator.perforator.LoadProfileFileAction"
                text="Load Profile File (.pb.gz)"
                description="Load profiling data from a downloaded .pb.gz file">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
